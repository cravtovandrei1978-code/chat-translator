{
  "manifest_version": 3,
  "name": "Chat Translator",
  "short_name": "ChatTranslator",
  "version": "0.2.1",
  "description": "Переводит сообщения веб-чатов на русский и помогает отвечать на языке собеседника.",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": [
    "storage",
    "scripting",
    "activeTab"
  ],
  "host_permissions": [
    "https://api-free.deepl.com/*",
    "https://api.deepl.com/*",
    "https://translation.googleapis.com/*",
    "https://api.anthropic.com/*"
  ],
  "background": {
    "service_worker": "background/service-worker.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "https://chaturbate.com/*",
        "https://*.chaturbate.com/*",
        "https://web.whatsapp.com/*",
        "https://web.telegram.org/*",
        "https://discord.com/*",
        "http://localhost/*",
        "http://127.0.0.1/*"
      ],
      "js": [
        "content/namespace.js",
        "content/adapters/chaturbate.js",
        "content/adapters/whatsapp.js",
        "content/adapters/telegram.js",
        "content/adapters/discord.js",
        "content/adapters/generic.js",
        "content/adapters/registry.js",
        "content/translit.js",
        "content/ui.js",
        "content/main.js"
      ],
      "css": [
        "content/ui.css"
      ],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "Chat Translator"
  },
  "options_page": "options/options.html",
  "optional_host_permissions": [
    "https://*/*",
    "http://*/*"
  ]
}
